# ============================================================
# Brindi - Variables de entorno de PRODUCCION (.env.prod.example)
# ------------------------------------------------------------
# Copia este archivo a .env.prod en el servidor y rellena los valores.
# Ver GUIA-PRODUCCION.md para instrucciones detalladas de cada variable.
#
# REGLAS:
#   - NUNCA subas .env.prod al repositorio (esta en .gitignore).
#   - Sin espacios alrededor del "=" y sin comentarios en la
#     misma linea del valor (compatibilidad docker compose).
# ============================================================

# ---------- App ----------
APP_NAME=Brindi

# ---------- Dominios ----------
# Sin "https://", solo el nombre de dominio/subdominio.
APP_DOMAIN=brindi.tudominio.com
API_DOMAIN=api.brindi.tudominio.com

# ---------- PostgreSQL ----------
POSTGRES_USER=brindi
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=brindi

# ---------- Autenticacion ----------
# Generar con: openssl rand -hex 48 (uno distinto para cada secreto)
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------- Secreto interno API <-> ai-service ----------
# Generar con: openssl rand -hex 32 (mismo valor para ambos servicios)
INTERNAL_API_KEY=

# ---------- Claves externas (RELLENAR MANUALMENTE) ----------
# Sin estas claves la app funciona, pero quedan deshabilitadas
# las funciones de IA (OCR de tickets, quiz IA, planes).

# OCR de tickets (DIVIDE): pool de claves de Gemini separadas por comas.
#   Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# (compatibilidad: una sola clave; se anade al pool de arriba)
GEMINI_API_KEY=

# Trivia "Otros" y PLAN: Groq como principal.
#   Obtener en: https://console.groq.com/keys
GROQ_API_KEY=

# Respaldos de texto si Groq falla (opcionales):
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Google OAuth 2.0 (login con Google). Opcional: sin client id/secret se desactiva.
# Obtener en: https://console.cloud.google.com/apis/credentials
# El URI de redireccion autorizado debe ser EXACTO: https://API_DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.brindi.tudominio.com/auth/google/callback

# ---------- Publicidad (Google AdSense) ----------
# Opcional: sin client id no se carga ningun anuncio.
# Se obtiene en https://adsense.google.com (requiere aprobar el sitio).
# Son variables de FRONTEND: se hornean en build (NEXT_PUBLIC_*).
# Si se rellenan despues del primer despliegue, hay que reconstruir con --build.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
