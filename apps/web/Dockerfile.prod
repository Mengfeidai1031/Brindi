# ============================================================
# Brindi web — imagen de producción (multi-stage, salida standalone)
# Resultado: imagen mínima que ejecuta `node server.js`.
# ============================================================

# 1) Dependencias
FROM node:25-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

# 2) Build (las NEXT_PUBLIC_* se hornean aquí, en build time)
FROM node:25-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_NAME=Brindi
ARG NEXT_PUBLIC_ADSENSE_CLIENT
ARG NEXT_PUBLIC_ADSENSE_SLOT_BANNER
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_ADSENSE_CLIENT=$NEXT_PUBLIC_ADSENSE_CLIENT
ENV NEXT_PUBLIC_ADSENSE_SLOT_BANNER=$NEXT_PUBLIC_ADSENSE_SLOT_BANNER
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# 3) Runtime mínimo
FROM node:25-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Usuario sin privilegios
RUN addgroup -g 1001 nodejs && adduser -u 1001 -G nodejs -S nextjs

# Solo lo necesario para servir: assets públicos, server standalone y estáticos
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
