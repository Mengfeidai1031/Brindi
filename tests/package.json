{
  "name": "@brindi/tests",
  "version": "0.1.0",
  "private": true,
  "description": "Pruebas E2E (Playwright), accesibilidad (axe), Lighthouse y carga (k6) de Brindi.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --grep-invert @backend",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lighthouse": "lhci autorun",
    "load": "k6 run load/smoke.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@lhci/cli": "^0.15.1"
  }
}
